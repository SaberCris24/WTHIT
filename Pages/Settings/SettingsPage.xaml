<Page
    x:Class="WTHIT.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="12"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Page Title -->
                <TextBlock Text="Settings"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontSize="40"
                           FontWeight="Bold"
                           Margin="80,25,0,0"/>

                <TextBlock Text="Configure your application preferences"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="80,0,0,24"/>

                <!-- API Configuration Section -->
                <TextBlock Text="API Configuration"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="80,25,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="80,0,80,16"
                        Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE9F9;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                  VerticalAlignment="Center"
                                  Margin="4,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="VirusTotal API Key"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Enter your VirusTotal API key for file scanning"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <PasswordBox x:Name="txtVirusTotalApiKey"
                                         PlaceholderText="Enter API key"
                                         Width="250"
                                         VerticalAlignment="Center"
                                         CornerRadius="6"/>
                            <Button x:Name="btnSaveApiKey"
                                    Click="btnSaveApiKey_Click"
                                    Padding="16,8"
                                    Height="36"
                                    Style="{StaticResource AccentButtonStyle}"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                    <TextBlock Text="Save" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Appearance & Behavior Section -->
                <TextBlock Text="Appearance &amp; behavior"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="80,25,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="80,0,80,16">

                    <StackPanel>
                        <!-- Theme -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE790;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="App theme"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Select which app theme to display"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ComboBox x:Name="cmbTheme"
                                      Grid.Column="2"
                                      MinWidth="150"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cmbTheme_SelectionChanged">
                                <ComboBoxItem Content="System Default" Tag="Default"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                            </ComboBox>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   Margin="16,0"/>

                        <!-- Backdrop -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE7B3;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Window backdrop"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Choose the window background effect"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ComboBox x:Name="cmbBackdrop"
                                      Grid.Column="2"
                                      MinWidth="150"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cmbBackdrop_SelectionChanged">
                                <ComboBoxItem Content="Mica" Tag="Mica" IsSelected="True"/>
                                <ComboBoxItem Content="Mica Alt" Tag="MicaAlt"/>
                                <ComboBoxItem Content="Acrylic" Tag="Acrylic"/>
                            </ComboBox>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   Margin="16,0"/>

                        <!-- Navigation -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xF594;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Navigation style"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Select where the navigation pane appears"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ComboBox x:Name="cmbNavPosition"
                                      Grid.Column="2"
                                      MinWidth="150"
                                      Height="32"
                                      VerticalAlignment="Center"
                                      SelectionChanged="cmbNavPosition_SelectionChanged">
                                <ComboBoxItem Content="Left" Tag="Left" IsSelected="True"/>
                                <ComboBoxItem Content="Top" Tag="Top"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Process List Settings Section -->
                <TextBlock Text="Process list settings"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="80,25,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="80,0,80,16">

                    <StackPanel>
                        <!-- Max Scan Results -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE9F9;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Max scan results"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Maximum number of scan results to keep"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <NumberBox x:Name="numMaxScanResults"
                                       Grid.Column="2"
                                       Width="120"
                                       Height="32"
                                       SmallChange="1"
                                       LargeChange="5"
                                       SpinButtonPlacementMode="Inline"
                                       VerticalAlignment="Center"
                                       ValueChanged="numMaxScanResults_ValueChanged"/>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   Margin="16,0"/>

                        <!-- Cache Size -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE88A;"
                                      FontSize="20"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Process cache size"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="CacheSizeText"
                                           Text="Current cache: 0 items"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button x:Name="btnClearCache"
                                    Grid.Column="2"
                                    Click="btnClearCache_Click"
                                    Padding="16,8"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data & Storage Section -->
                <TextBlock Text="Data &amp; storage"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="80,25,0,12"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="80,0,80,16">

                    <StackPanel>
                        <!-- Clear Scan History -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE9F9;"
                                      FontSize="20"
                                      Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Clear scan history"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Remove all saved VirusTotal scan results from disk"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button x:Name="btnClearScanHistory"
                                    Grid.Column="2"
                                    Click="btnClearScanHistory_Click"
                                    Padding="16,8"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                   Margin="16,0"/>

                        <!-- Reset Settings -->
                        <Grid Height="72" Padding="16,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE777;"
                                      FontSize="20"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      VerticalAlignment="Center"
                                      Margin="4,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Reset all settings"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Restore all settings to their default values"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button x:Name="btnResetSettings"
                                    Grid.Column="2"
                                    Click="btnResetSettings_Click"
                                    Padding="16,8"
                                    Height="32"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                    <TextBlock Text="Reset" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Bottom spacing -->
                <Rectangle Height="24" Fill="Transparent"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
