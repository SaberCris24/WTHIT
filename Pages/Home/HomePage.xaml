<Page
    x:Class="WTHIT.Pages.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TopProcessItemTemplate">
            <Border CornerRadius="8" Padding="16,12" Margin="0,2"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="28" Height="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{Binding ProcessIcon, Mode=OneWay}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="PID: "/><Run Text="{Binding ProcessId}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding CpuUsage}" FontWeight="Bold" FontSize="14"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="CPU" FontSize="10" FontWeight="Medium"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding MemoryUsage}" FontWeight="Bold" FontSize="14"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Memory" FontSize="10" FontWeight="Medium"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="4" Click="ViewDetailsTopProcessButton_Click"
                            Padding="16,8" MinWidth="110" Height="36"
                            VerticalAlignment="Center" CornerRadius="6"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="View process details">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="12"/>
                            <TextBlock Text="Details" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Home" Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontSize="40" FontWeight="Bold" Margin="80,25,0,8"/>

                <TextBlock Text="Welcome to WTHIT" Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="80,0,0,32"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Margin="80,0,80,24" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,20">
                            <Border Width="32" Height="32" CornerRadius="6"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <FontIcon Glyph="&#xE909;" FontSize="16"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="System Overview" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Real-time system metrics" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="32" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="Processes" FontSize="13" FontWeight="Medium"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalProcessesText" Text="0" FontSize="28" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="32" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="Windows Version" FontSize="13" FontWeight="Medium"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="WindowsVersionText" Text="Loading..." FontSize="16" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE823;" FontSize="32" HorizontalAlignment="Center"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Text="Uptime" FontSize="13" FontWeight="Medium"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="UptimeText" Text="0d 0h 0m" FontSize="28" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Margin="80,0,80,24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <Border Width="32" Height="32" CornerRadius="6"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Top Processes" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Highest resource usage" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="RefreshTopProcessesButton"
                                    Click="RefreshTopProcessesButton_Click"
                                    Width="36" Height="36" Padding="0"
                                    ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh processes"
                                    VerticalAlignment="Center" CornerRadius="6"
                                    Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <ListView x:Name="TopProcessesListView" Grid.Row="1"
                                  SelectionMode="None" HorizontalAlignment="Stretch" MaxHeight="480"
                                  ItemTemplate="{StaticResource TopProcessItemTemplate}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
