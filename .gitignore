## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# NuGet restore
project.lock.json
project.fragment.lock.json
artifacts/

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.ipdb
*.tlog
*.lastbuildstate
*.build.props
*.build.targets

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
/build.log
*.binlog

# Backup & report files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# Node.js (if using)
node_modules/

# Windows App SDK / WinUI
AppPackages/
BundleArtifacts/
*.appx
*.msix
*.appxbundle
*.msixbundle
*.appxupload
*.msixupload
*.eappx
*.emsix
*.eappxbundle
*.emsixbundle
*.pri
*.priinfo
*.pdb
*.exp
*.lib

# Local credentials and signing keys
.env
.env.*
!.env.example
appsettings.local.json
*.key
*.pem
*.crt
*.pfx
*.p12
secrets.json
**/appsettings.*.json
!appsettings.example.json

# Local configuration with API keys
LocalSettings/
/settings.json
/settings.json.*.tmp
/scan-history.json

# Local databases and SQLite sidecars
*.db
*.db-shm
*.db-wal
*.db-journal
!/Assets/ProcessInfo.db

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
