<UserControl
    x:Class="WTHIT.Controls.NotificationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SeverityStates">
                <VisualState x:Name="Info"/>
                <VisualState x:Name="Success">
                    <VisualState.Setters>
                        <Setter Target="SeverityIcon.Glyph" Value="&#xE73E;"/>
                        <Setter Target="SeverityIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="SeverityIcon.Glyph" Value="&#xE7BA;"/>
                        <Setter Target="SeverityIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="SeverityIcon.Glyph" Value="&#xEA39;"/>
                        <Setter Target="SeverityIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12,8,12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="SeverityIcon"
                          Glyph="&#xE946;"
                          FontSize="18"
                          Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                          VerticalAlignment="Top"
                          Margin="0,2,0,0"/>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock x:Name="TitleText" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="MessageText"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="4"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                    <Button x:Name="CopyButton" Width="30" Height="30" Padding="0"
                            Click="CopyButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Copy notification details"
                            ToolTipService.ToolTip="Copy details">
                        <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="14"/>
                    </Button>
                    <Button Width="30" Height="30" Padding="0"
                            Click="CloseButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            AutomationProperties.Name="Dismiss notification"
                            ToolTipService.ToolTip="Dismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
